
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title id="pageTitle">Language Lesson</title><style>
*{box-sizing:border-box;margin:0;padding:0}body{font-family:'Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif;background:#d1d7db;display:flex;justify-content:center;align-items:center;height:100vh}.phone{width:100%;max-width:420px;height:90vh;background:#efeae2;border-radius:16px;box-shadow:0 6px 30px rgba(0,0,0,.25);display:flex;flex-direction:column;overflow:hidden}.header{background:#008069;color:white;padding:12px 16px;display:flex;align-items:center}.avatar{width:40px;height:40px;border-radius:50%;background:#ccc;display:flex;align-items:center;justify-content:center;margin-right:10px;font-size:20px}.contact{display:flex;flex-direction:column}.name{font-weight:600;font-size:16px}.status{font-size:13px;color:#d9fdd3}.chat{flex:1;padding:20px 16px;overflow-y:auto;display:flex;flex-direction:column;background-image:radial-gradient(#d4d0c8 1px,transparent 1px);background-size:20px 20px}.message{max-width:80%;padding:8px 12px;border-radius:8px;margin-bottom:12px;font-size:15px;line-height:1.4;position:relative;box-shadow:0 1px .5px rgba(11,20,26,.13);opacity:0;transform:translateY(8px);animation:fade .3s forwards ease-out}.message.narrator{background:white;align-self:flex-start;border-top-left-radius:0}.message.a{background:#1f7aec;color:white;align-self:flex-start;border-top-left-radius:0}.message.b{background:#9333ea;color:white;align-self:flex-end;border-top-right-radius:0}.message.answer{background:#dcf8c6;align-self:flex-end;border-top-right-radius:0}.message::before{content:'';position:absolute;top:0}.message.narrator::before{left:-10px;border-top:10px solid white;border-left:10px solid transparent}.message.a::before{left:-10px;border-top:10px solid #1f7aec;border-left:10px solid transparent}.message.b::before{right:-10px;border-top:10px solid #9333ea;border-right:10px solid transparent}.message.answer::before{right:-10px;border-top:10px solid #dcf8c6;border-right:10px solid transparent}.typing{background:white;padding:10px 15px;border-radius:20px;margin-bottom:12px;display:none;align-self:flex-start}.dot{display:inline-block;width:6px;height:6px;background:#8696a0;border-radius:50%;margin:0 2px;animation:bounce 1.4s infinite}.input{height:60px;background:#f0f2f5;display:flex;align-items:center;padding:10px}.box{flex:1;height:40px;background:white;border-radius:20px;display:flex;align-items:center;padding:0 15px;color:#888}.send{width:40px;height:40px;background:#00a884;border-radius:50%;margin-left:10px;display:flex;align-items:center;justify-content:center;color:white;cursor:pointer}@keyframes fade{to{opacity:1;transform:translateY(0)}}@keyframes bounce{0%,80%,100%{transform:scale(0)}40%{transform:scale(1)}}b{font-weight:700}</style></head><body><div class="phone"><div class="header"><div class="avatar" id="uiAvatar"></div><div class="contact"><div class="name" id="uiName"></div><div class="status" id="status">online</div></div></div><div class="chat" id="chat"><div class="typing" id="typing"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div></div><div class="input"><div class="box" id="uiPlaceholder">Type a message</div><div class="send">➤</div></div></div><script>const config={pageTitle:"Language Lesson",tutorName:"Tutor",avatarEmoji:"🌍",inputPlaceholder:"Type a message",ttsLanguage:"en-US",typingDelayMs:1200,answerWaitMs:30000,baseReadingTimeMs:1500,readingTimePerCharMs:35}
const vocab={}
const script=[]
document.getElementById("pageTitle").innerText=config.pageTitledocument.getElementById("uiName").innerText=config.tutorNamedocument.getElementById("uiAvatar").innerText=config.avatarEmojidocument.getElementById("uiPlaceholder").innerText=config.inputPlaceholder;const chat=document.getElementById("chat");const typing=document.getElementById("typing");const status=document.getElementById("status");const sendBtn=document.querySelector(".send");let index=0;let state="IDLE";let autoTimer=null;let nextTimer=null;let typingTimer=null;let startTime=Date.now();let finished=false;function boldWords(text){for(const w in vocab){if(!vocab[w]&&text.toLowerCase().includes(w)){vocab[w]=true;text=text.replace(new RegExp(w,"i"),"<b>"+w+"</b>")}}return text}function readingTime(text){return config.baseReadingTimeMs+text.length*config.readingTimePerCharMs}function speak(text){const utter=new SpeechSynthesisUtterance(text);utter.lang=config.ttsLanguage;speechSynthesis.speak(utter)}function scrollBottom(){chat.scrollTop=chat.scrollHeight}function addBubble(type,text){const bubble=document.createElement("div");bubble.className="message "+type;bubble.innerHTML=boldWords(text);chat.appendChild(bubble);scrollBottom();if(type!=="narrator")speak(text)}function next(){if(index>=script.length){if(!finished){finished=true;const elapsed=Math.floor((Date.now()-startTime)/1000);const mins=Math.floor(elapsed/60);const secs=elapsed%60;const finalMsg="Thanks for finishing this lesson! You finished it in "+mins+" minutes and "+secs+" seconds.";state="TYPING";status.innerText="typing...";typing.style.display="block";chat.appendChild(typing);scrollBottom();setTimeout(()=>{typing.style.display="none";status.innerText="online";addBubble("narrator",finalMsg);state="IDLE"},1200)}return}if(state==="TYPING")return;const item=script[index];if(item.type==="answer"){state="WAITING";autoTimer=setTimeout(revealAnswer,config.answerWaitMs);return}state="TYPING";status.innerText="typing...";typing.style.display="block";chat.appendChild(typing);scrollBottom();typingTimer=setTimeout(()=>{finishTyping(item)},config.typingDelayMs)}function finishTyping(item){typing.style.display="none";status.innerText="online";addBubble(item.type,item.text);index++;state="READING";nextTimer=setTimeout(()=>{if(state==="READING"){state="IDLE";next()}},readingTime(item.text))}function revealAnswer(){if(state!=="WAITING")return;clearTimeout(autoTimer);const item=script[index];addBubble("answer",item.text);index++;state="READING";nextTimer=setTimeout(()=>{if(state==="READING"){state="IDLE";next()}},readingTime(item.text))}function advance(){if(state==="WAITING"){revealAnswer()}else if(state==="READING"){clearTimeout(nextTimer);state="IDLE";next()}else if(state==="TYPING"){clearTimeout(typingTimer);finishTyping(script[index])}}document.addEventListener("click",(e)=>{if(!e.target.closest('.input'))advance()});document.addEventListener("keydown",advance);sendBtn.addEventListener("click",advance);next()</script></body></html>
