<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title id="pageTitle">Language Lesson</title><style>
*{box-sizing:border-box;margin:0;padding:0}body{font-family:'Segoe UI','Helvetica Neue',Helvetica,Arial,sans-serif;background:#d1d7db;display:flex;justify-content:center;align-items:center;height:100vh}.phone{width:100%;max-width:420px;height:90vh;background:#efeae2;border-radius:16px;box-shadow:0 6px 30px rgba(0,0,0,.25);display:flex;flex-direction:column;overflow:hidden}.header{background:#008069;color:white;padding:12px 16px;display:flex;align-items:center}.avatar{width:40px;height:40px;border-radius:50%;background:#ccc;display:flex;align-items:center;justify-content:center;margin-right:10px;font-size:20px}.contact{display:flex;flex-direction:column}.name{font-weight:600;font-size:16px}.status{font-size:13px;color:#d9fdd3}.chat{flex:1;padding:20px 16px;overflow-y:auto;display:flex;flex-direction:column;background-image:radial-gradient(#d4d0c8 1px,transparent 1px);background-size:20px 20px}.message{max-width:80%;padding:8px 12px;border-radius:8px;margin-bottom:12px;font-size:15px;line-height:1.4;position:relative;box-shadow:0 1px .5px rgba(11,20,26,.13);opacity:0;transform:translateY(8px);animation:fade .3s forwards ease-out}.message.narrator{background:white;align-self:flex-start;border-top-left-radius:0}.message.a{background:#1f7aec;color:white;align-self:flex-start;border-top-left-radius:0}.message.b{background:#9333ea;color:white;align-self:flex-end;border-top-right-radius:0}.message.answer{background:#dcf8c6;align-self:flex-end;border-top-right-radius:0}.message::before{content:'';position:absolute;top:0}.message.narrator::before{left:-10px;border-top:10px solid white;border-left:10px solid transparent}.message.a::before{left:-10px;border-top:10px solid #1f7aec;border-left:10px solid transparent}.message.b::before{right:-10px;border-top:10px solid #9333ea;border-right:10px solid transparent}.message.answer::before{right:-10px;border-top:10px solid #dcf8c6;border-right:10px solid transparent}.typing{background:white;padding:10px 15px;border-radius:20px;margin-bottom:12px;display:none;align-self:flex-start}.dot{display:inline-block;width:6px;height:6px;background:#8696a0;border-radius:50%;margin:0 2px;animation:bounce 1.4s infinite}.input{height:60px;background:#f0f2f5;display:flex;align-items:center;padding:10px}.box{flex:1;height:40px;background:white;border-radius:20px;display:flex;align-items:center;padding:0 15px;color:#888}.send{width:40px;height:40px;background:#00a884;border-radius:50%;margin-left:10px;display:flex;align-items:center;justify-content:center;color:white;cursor:pointer}@keyframes fade{to{opacity:1;transform:translateY(0)}}@keyframes bounce{0%,80%,100%{transform:scale(0)}40%{transform:scale(1)}}b{font-weight:700}</style></head><body><div class="phone"><div class="header"><div class="avatar" id="uiAvatar"></div><div class="contact"><div class="name" id="uiName"></div><div class="status" id="status">online</div></div></div><div class="chat" id="chat"><div class="typing" id="typing"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div></div><div class="input"><div class="box" id="uiPlaceholder">Type a message</div><div class="send">➤</div></div></div><script>const config={pageTitle:"Language Lesson",tutorName:"Tutor",avatarEmoji:"🌍",inputPlaceholder:"Type a message",ttsLanguage:"nb-NO",typingDelayMs:1200,answerWaitMs:30000,baseReadingTimeMs:1500,readingTimePerCharMs:35};const vocab={};const script=[
  {"type": "narrator", "text": "Imagine you are catching up with a friend in a cozy cafe in Oslo. You are recounting a bizarre former living situation with an eccentric landlord. Listen to the conversation."},
  {"type": "a", "text": "Jeg følte meg så voksen da jeg flyttet inn. Men det var strengt forbudt å ta med noe inn på stua!"},
  {"type": "b", "text": "Hæ? Noe så ekkel oppførsel. Han utnytter systemet, ikke sant?"},
  {"type": "a", "text": "Absolutt. Jeg drev med administrasjon og var i bunn og grunn kokken hjemme. Vi måtte benytte den sjansen til å flytte."},
  {"type": "b", "text": "De fleste jeg kjenner slår på lyset når de kommer hjem, men han gjorde vel noe helt annet?"},
  {"type": "a", "text": "Stemmer. Han sa alltid: 'Du trenger ikke ta med noe', og ba meg tørke overalt. Han ville ikke miste oss, men til slutt måtte han akseptere min avgjørelse."},
  {"type": "b", "text": "Jeg anser meg selv som en tålmodig person, men det der er for drøyt."},
  {"type": "a", "text": "Ja, han trodde han var grei, men dette er ikke tilfelle."},
  {"type": "narrator", "text": "Before we break that down, let's quickly reactivate your brain from the last lesson. How do you say 'I was there yesterday'?"},
  {"type": "answer", "text": "Jeg var der i går."},
  {"type": "narrator", "text": "Excellent. Now let's isolate the first major phrase. Listen to how you say 'grown up'."},
  {"type": "answer", "text": "voksen"},
  {"type": "narrator", "text": "And how do you say 'I felt so grown up'?"},
  {"type": "answer", "text": "Jeg følte meg så voksen."},
  {"type": "narrator", "text": "Say it again, focusing entirely on the melody of the speaker's voice."},
  {"type": "answer", "text": "Jeg følte meg så voksen."},
  {"type": "narrator", "text": "That long phrase about your chores was tricky. Let's break it down into manageable chunks. First, the phrase for 'basically', which literally translates to 'at bottom and ground'. Listen and repeat."},
  {"type": "answer", "text": "i bunn og grunn"},
  {"type": "narrator", "text": "Now, 'was basically the chef at home'."},
  {"type": "answer", "text": "var i bunn og grunn kokken hjemme"},
  {"type": "narrator", "text": "Add 'administration and' to the front."},
  {"type": "answer", "text": "administrasjon og var i bunn og grunn kokken hjemme"},
  {"type": "narrator", "text": "Great. The next difficult phrase is 'it was strictly forbidden'. Listen to the word for 'strictly'."},
  {"type": "answer", "text": "strengt"},
  {"type": "narrator", "text": "And 'forbidden'."},
  {"type": "answer", "text": "forbudt"},
  {"type": "narrator", "text": "Put them together: 'strictly forbidden'."},
  {"type": "answer", "text": "strengt forbudt"},
  {"type": "narrator", "text": "How do you say: 'It was strictly forbidden'?"},
  {"type": "answer", "text": "det var strengt forbudt"},
  {"type": "narrator", "text": "Let's focus on the word for 'decision'. We will build it backwards to get the pronunciation perfect. Listen and mimic."},
  {"type": "answer", "text": "-se"},
  {"type": "answer", "text": "-else"},
  {"type": "answer", "text": "-gjørelse"},
  {"type": "answer", "text": "avgjørelse"},
  {"type": "narrator", "text": "Ask your friend to accept it. 'Accept my decision'."},
  {"type": "answer", "text": "akseptere min avgjørelse"},
  {"type": "narrator", "text": "You want to say 'This is not the case'. In Norwegian, it maps literally to 'This is not case'. Listen and say 'the case'."},
  {"type": "answer", "text": "tilfelle"},
  {"type": "narrator", "text": "Now say: 'This is not the case'."},
  {"type": "answer", "text": "dette er ikke tilfelle"},
  {"type": "narrator", "text": "Let's introduce a new phrase. 'He takes advantage of the system'. Listen."},
  {"type": "answer", "text": "han utnytter systemet"},
  {"type": "narrator", "text": "Turn it into a question. 'Does he take advantage of the system?'"},
  {"type": "answer", "text": "utnytter han systemet?"},
  {"type": "narrator", "text": "Quick check from a few minutes ago. How do you say 'I felt so grown up'?"},
  {"type": "answer", "text": "jeg følte meg så voksen"},
  {"type": "narrator", "text": "Notice how the verb jumps to the second position when we start with something other than a simple subject. Let's try: 'Most people I know turn on the light'."},
  {"type": "answer", "text": "de fleste jeg kjenner slår på lyset"},
  {"type": "narrator", "text": "Ask someone directly: 'Do most people you know turn on the light?'"},
  {"type": "answer", "text": "slår de fleste du kjenner på lyset?"},
  {"type": "narrator", "text": "You are describing his strange habits. 'He did something completely different'."},
  {"type": "answer", "text": "han gjorde noe helt annet"},
  {"type": "narrator", "text": "Let's practice the core phrase. Say 'something completely different'."},
  {"type": "answer", "text": "noe helt annet"},
  {"type": "narrator", "text": "Let's practice a negative structure. 'You do not need to bring anything'."},
  {"type": "answer", "text": "du trenger ikke ta med noe"},
  {"type": "narrator", "text": "Tell him firmly: 'You don't need to bring anything'."},
  {"type": "answer", "text": "du trenger ikke ta med noe"},
  {"type": "narrator", "text": "Let's juggle a few steps. Say hello, state 'You don't need to bring anything', then ask 'Do you turn on the light?'"},
  {"type": "answer", "text": "Hei. Du trenger ikke ta med noe. Slår du på lyset?"},
  {"type": "narrator", "text": "He was quite controlling but desperate to keep tenants. Say 'He didn't want to lose us'."},
  {"type": "answer", "text": "han ville ikke miste oss"},
  {"type": "narrator", "text": "Let's flip the tense. 'He doesn't want to lose us'."},
  {"type": "answer", "text": "han vil ikke miste oss"},
  {"type": "narrator", "text": "Back to the past: 'He didn't want to lose us'."},
  {"type": "answer", "text": "han ville ikke miste oss"},
  {"type": "narrator", "text": "Listen to these two phrases and spot the grammatical difference in the verb."},
  {"type": "answer", "text": "vi må benytte den"},
  {"type": "answer", "text": "vi måtte benytte den"},
  {"type": "narrator", "text": "The second one is past tense. Say 'We had to use it'."},
  {"type": "answer", "text": "vi måtte benytte den"},
  {"type": "narrator", "text": "Say the word for 'disgusting' or 'gross' in its neutral form."},
  {"type": "answer", "text": "ekkelt"},
  {"type": "narrator", "text": "It changes based on gender. For a masculine noun or describing a person, it is 'ekkel'. Listen."},
  {"type": "answer", "text": "ekkel"},
  {"type": "narrator", "text": "Trap prompt! Translate: 'He takes advantage of the system', making sure the verb is in the right place."},
  {"type": "answer", "text": "han utnytter systemet"},
  {"type": "narrator", "text": "Let's add some flavor to make you sound like a local. How about 'actually'? Listen."},
  {"type": "answer", "text": "faktisk"},
  {"type": "narrator", "text": "Now say: 'Actually, this is not the case'. Remember the verb placement after the word 'faktisk'!"},
  {"type": "answer", "text": "faktisk er dette ikke tilfelle"},
  {"type": "narrator", "text": "He always asked you 'to dry' or 'to wipe' the surfaces. Listen to the word."},
  {"type": "answer", "text": "tørke"},
  {"type": "narrator", "text": "Tell him: 'You don't need to dry anything'."},
  {"type": "answer", "text": "du trenger ikke tørke noe"},
  {"type": "narrator", "text": "Let's flex a new phrase. Listen to 'I consider myself a [blank] person'."},
  {"type": "answer", "text": "jeg anser meg selv som en _____ person"},
  {"type": "narrator", "text": "Fill in the blank with the Norwegian word for patient, 'tålmodig'. 'I consider myself a patient person'."},
  {"type": "answer", "text": "jeg anser meg selv som en tålmodig person"},
  {"type": "narrator", "text": "Now flex it to the 'We' perspective. 'We consider ourselves patient people'."},
  {"type": "answer", "text": "vi anser oss selv som tålmodige personer"},
  {"type": "narrator", "text": "Remember our long phrase about chores? Use just the 'basically' part on its own. Say: 'It is basically disgusting'."},
  {"type": "answer", "text": "det er i bunn og grunn ekkelt"},
  {"type": "narrator", "text": "Let's use a conjunction bridge. Join two ideas with 'but'. 'He didn't want to lose us, but he had to accept my decision'."},
  {"type": "answer", "text": "han ville ikke miste oss, men han måtte akseptere min avgjørelse"},
  {"type": "narrator", "text": "Re-engagement prompt. How did you say 'It was strictly forbidden'?"},
  {"type": "answer", "text": "det var strengt forbudt"},
  {"type": "narrator", "text": "Let's do a mini roleplay. I will ask you about the old apartment. Answer that it was strictly forbidden to bring anything."},
  {"type": "a", "text": "Var det hyggelig å bo der?"},
  {"type": "answer", "text": "Nei, det var strengt forbudt å ta med noe."},
  {"type": "narrator", "text": "Let's shift the tense of an earlier phrase. Say 'Most people I know turned on the light'."},
  {"type": "answer", "text": "de fleste jeg kjenner slo på lyset"},
  {"type": "narrator", "text": "Tell him directly: 'It is something completely different'."},
  {"type": "answer", "text": "det er noe helt annet"},
  {"type": "narrator", "text": "Combine two entirely different thoughts. 'I felt so grown up, but this is not the case'."},
  {"type": "answer", "text": "jeg følte meg så voksen, men dette er ikke tilfelle"},
  {"type": "narrator", "text": "Personalize it. Tell me about yourself using an adjective you know. 'I consider myself a [insert trait] person'."},
  {"type": "answer", "text": "jeg anser meg selv som en rolig person"},
  {"type": "narrator", "text": "Role reversal. You ask me the question: 'Did he take advantage of the system?'"},
  {"type": "answer", "text": "utnyttet han systemet?"},
  {"type": "narrator", "text": "Spaced repetition hit from three lessons ago. How do you say 'I am tired'?"},
  {"type": "answer", "text": "jeg er trøtt"},
  {"type": "narrator", "text": "Let's check where the negative goes in our new structure. Say 'We did not have to use it'."},
  {"type": "answer", "text": "vi måtte ikke benytte den"},
  {"type": "narrator", "text": "Prepare for the simulation by combining your thoughts into a paragraph. 'Most people I know turn on the light. This is not the case here. It is something completely different'."},
  {"type": "answer", "text": "de fleste jeg kjenner slår på lyset. dette er ikke tilfelle her. det er noe helt annet."},
  {"type": "narrator", "text": "The Gauntlet Commences. You bump into your former strange landlord on the street. No more hand-holding. Formulate your replies in the pauses. He approaches you. Greet him and say you felt so grown up living there."},
  {"type": "a", "text": "Hei, lenge siden sist! Går det bra?"},
  {"type": "answer", "text": "Hei! Ja, jeg følte meg så voksen der."},
  {"type": "narrator", "text": "He tries to justify his strict rules. Tell him it was strictly forbidden to do anything."},
  {"type": "a", "text": "Reglene mine var til for å beskytte leiligheten, vet du."},
  {"type": "answer", "text": "Det var strengt forbudt å gjøre noe."},
  {"type": "narrator", "text": "Complain about the chores. Tell him you did administration and were basically the chef at home."},
  {"type": "answer", "text": "Jeg gjorde administrasjon og var i bunn og grunn kokken hjemme."},
  {"type": "narrator", "text": "Tell him his behavior is gross and he takes advantage of the system."},
  {"type": "answer", "text": "Det er ekkelt, du utnytter systemet."},
  {"type": "narrator", "text": "He deflects and says you had too many guests. Respond: 'You don't need to bring anything, you said!'"},
  {"type": "a", "text": "Du hadde for mange ting og folk med deg."},
  {"type": "answer", "text": "Du trenger ikke ta med noe, sa du!"},
  {"type": "narrator", "text": "He looks defensive. Remind him he didn't want to lose you, but we had to use it (the chance to leave)."},
  {"type": "answer", "text": "Du ville ikke miste oss, men vi måtte benytte den sjansen."},
  {"type": "narrator", "text": "Tell him he must accept your decision. Say 'It is something completely different now'."},
  {"type": "answer", "text": "Du må akseptere min avgjørelse. Det er noe helt annet nå."},
  {"type": "narrator", "text": "Finish by saying 'Most people I know wipe their own tables. I consider myself a patient person, but this is not the case anymore.'"},
  {"type": "answer", "text": "De fleste jeg kjenner tørker sine egne bord. Jeg anser meg selv som en tålmodig person, men dette er ikke tilfelle lenger."},
  {"type": "narrator", "text": "That was the 80% Mastery Rule check. If you stumbled on more than two of those responses, you must repeat this audio block. Otherwise, let's transition to the reading phase."},
  {"type": "narrator", "text": "Welcome to the translation appendix. I will give you 10 English sentences. Translate them aloud, and the correct text will appear."},
  {"type": "narrator", "text": "Translate this sentence: I consider myself a mature person, but I felt so grown up."},
  {"type": "answer", "text": "Jeg anser meg selv som en moden person, men jeg følte meg så voksen."},
  {"type": "narrator", "text": "Translate this sentence: This is not the case, it is strictly forbidden."},
  {"type": "answer", "text": "Dette er ikke tilfelle, det er strengt forbudt."},
  {"type": "narrator", "text": "Translate this sentence: Most people I know do something completely different."},
  {"type": "answer", "text": "De fleste jeg kjenner gjør noe helt annet."},
  {"type": "narrator", "text": "Translate this sentence: He didn't want to lose us, because he takes advantage of the system."},
  {"type": "answer", "text": "Han ville ikke miste oss, fordi han utnytter systemet."},
  {"type": "narrator", "text": "Translate this sentence: You don't need to bring anything to dry the table."},
  {"type": "answer", "text": "Du trenger ikke ta med noe for å tørke bordet."},
  {"type": "narrator", "text": "Translate this sentence: He must accept my decision, we had to use it."},
  {"type": "answer", "text": "Han må akseptere min avgjørelse, vi måtte benytte den."},
  {"type": "narrator", "text": "Translate this sentence: I was doing administration and was basically the chef at home."},
  {"type": "answer", "text": "Jeg drev med administrasjon og var i bunn og grunn kokken hjemme."},
  {"type": "narrator", "text": "Translate this sentence: It is disgusting that most people I know exploit the system."},
  {"type": "answer", "text": "Det er ekkelt at de fleste jeg kjenner utnytter systemet."},
  {"type": "narrator", "text": "Translate this sentence: He turns on the light because it is something completely different."},
  {"type": "answer", "text": "Han slår på lyset fordi det er noe helt annet."},
  {"type": "narrator", "text": "Translate this sentence: You don't need to bring anything, but this is not the case."},
  {"type": "answer", "text": "Du trenger ikke ta med noe, men dette er ikke tilfelle."}
];document.getElementById("pageTitle").innerText = config.pageTitle;document.getElementById("uiName").innerText = config.tutorName;document.getElementById("uiAvatar").innerText = config.avatarEmoji;document.getElementById("uiPlaceholder").innerText = config.inputPlaceholder;const chat=document.getElementById("chat");const typing=document.getElementById("typing");const status=document.getElementById("status");const sendBtn=document.querySelector(".send");let index=0; let state="IDLE"; let autoTimer=null; let nextTimer=null; let typingTimer=null; let startTime=Date.now(); let finished=false;function boldWords(text){for(const w in vocab){if(!vocab[w]&&text.toLowerCase().includes(w)){vocab[w]=true;text=text.replace(new RegExp(w,"i"),"<b>"+w+"</b>")}}return text}function readingTime(text){return config.baseReadingTimeMs+text.length*config.readingTimePerCharMs}function speak(text){const utter=new SpeechSynthesisUtterance(text);utter.lang=config.ttsLanguage;speechSynthesis.speak(utter)}function scrollBottom(){chat.scrollTop=chat.scrollHeight}function addBubble(type,text){const bubble=document.createElement("div");bubble.className="message "+type;bubble.innerHTML=boldWords(text);chat.appendChild(bubble);scrollBottom();if(type!=="narrator")speak(text)}function next(){
  if(index>=script.length){
    if(!finished){
      finished=true;
      const elapsed=Math.floor((Date.now()-startTime)/1000);
      const mins=Math.floor(elapsed/60);
      const secs=elapsed%60;
      const finalMsg="Thanks for finishing this lesson! You finished it in "+mins+" minutes and "+secs+" seconds.";
      state="TYPING"; status.innerText="typing..."; typing.style.display="block"; chat.appendChild(typing); scrollBottom();
      setTimeout(()=>{typing.style.display="none";status.innerText="online";addBubble("narrator",finalMsg);state="IDLE"},1200);
    }
    return;
  }
  if(state==="TYPING")return;
  const item=script[index];
  if(item.type==="answer"){state="WAITING";autoTimer=setTimeout(revealAnswer,config.answerWaitMs);return;}
  state="TYPING"; status.innerText="typing..."; typing.style.display="block"; chat.appendChild(typing); scrollBottom();
  typingTimer=setTimeout(()=>{finishTyping(item)},config.typingDelayMs);
}function finishTyping(item){
  typing.style.display="none"; status.innerText="online"; addBubble(item.type,item.text); index++; state="READING";
  nextTimer=setTimeout(()=>{if(state==="READING"){state="IDLE";next()}},readingTime(item.text));
}function revealAnswer(){
  if(state!=="WAITING")return;
  clearTimeout(autoTimer); const item=script[index]; addBubble("answer",item.text); index++; state="READING";
  nextTimer=setTimeout(()=>{if(state==="READING"){state="IDLE";next()}},readingTime(item.text));
}function advance(){
  if(state==="WAITING"){revealAnswer()}
  else if(state==="READING"){clearTimeout(nextTimer);state="IDLE";next()}
  else if(state==="TYPING"){clearTimeout(typingTimer);finishTyping(script[index])}
}document.addEventListener("click",(e)=>{if(!e.target.closest('.input'))advance()});document.addEventListener("keydown",advance);
sendBtn.addEventListener("click",advance);
next();</script></body></html>
